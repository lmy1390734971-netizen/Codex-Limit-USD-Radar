<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        Title="Token Rader — Codex 用量仪表盘"
        Width="1280" Height="840" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B1016" Foreground="#ECF4F2"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121A22"/>
        <SolidColorBrush x:Key="CardBrush" Color="#16212B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#273642"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A3AE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#59E1C2"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#66AFFF"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF6F3"/>
            <Setter Property="Background" Value="#1C2A34"/>
            <Setter Property="BorderBrush" Value="#344854"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#28404A"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#59E1C2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38"/>
                                <Setter Property="Foreground" Value="#819198"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#14202A"/>
            <Setter Property="Background" Value="#EAF1F3"/>
            <Setter Property="BorderBrush" Value="#344854"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#14202A"/>
            <Setter Property="Background" Value="#EAF1F3"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C6D4D9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#C7D6DA"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="#101820" BorderBrush="#202F39"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#192630"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#17342F"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#59E1C2"/>
                                <Setter Property="Foreground" Value="#F3FFFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111A22"/>
            <Setter Property="Foreground" Value="#D9E5E6"/>
            <Setter Property="BorderBrush" Value="#273642"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#111A22"/>
            <Setter Property="AlternatingRowBackground" Value="#15212A"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#26343E"/>
            <Setter Property="VerticalGridLinesBrush" Value="#26343E"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A2730"/>
            <Setter Property="Foreground" Value="#9FB1B8"/>
            <Setter Property="BorderBrush" Value="#2B3A44"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E151C" BorderBrush="#22313B" BorderThickness="0,0,0,1">
            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="#173C35" VerticalAlignment="Center">
                    <TextBlock Text="TR" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Token Rader" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="本地 Codex 会话用量 · API 等价成本" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="AutoRefreshCheckBox" Content="每 5 分钟自动刷新" IsChecked="True" Margin="0,0,15,0"/>
                    <ComboBox x:Name="HistoryRangeComboBox" Width="105" SelectedIndex="0" Margin="0,0,8,0"
                              ToolTip="历史显示范围（最近1天表示当前时刻向前24小时）">
                        <ComboBoxItem Content="最近1天" Tag="1"/>
                        <ComboBoxItem Content="最近7天" Tag="7"/>
                        <ComboBoxItem Content="最近30天" Tag="30"/>
                        <ComboBoxItem Content="最近90天" Tag="90"/>
                        <ComboBoxItem Content="全部" Tag="0"/>
                    </ComboBox>
                    <Button x:Name="RefreshButton" Content="立即刷新结果" Margin="0,0,8,0"/>
                    <Button x:Name="RebuildIndexButton" Content="完整重建"/>
                    <Button x:Name="PurgeOldIndexButton" Content="清理30天前索引" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="当前认证账号" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="AccountNameText" Text="正在读取…" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="#17342F" CornerRadius="6" Padding="8,3">
                                <TextBlock x:Name="PlanText" Text="计划：—" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                            </Border>
                            <TextBlock x:Name="AccountIdText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="AccountHintText" Text="账号只用于标记当前选中会话" Foreground="#6F858F"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="15">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="指定时间段" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="全部项目 · 全部 Codex 会话" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                           TextWrapping="Wrap" MaxWidth="205" HorizontalAlignment="Left" Margin="0,2,8,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#28333B" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock x:Name="IntervalStatusText" Text="未开始" Foreground="#AABAC0" FontSize="10"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="IntervalTimeText" Text="先开始计算，再运行 Codex；完成后结束计算。"
                                   Foreground="#7E939C" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartMeasureButton" Content="开始计算" Background="#17443A" BorderBrush="#2B806D" Padding="7,7" FontSize="11"/>
                            <Button x:Name="StopMeasureButton" Grid.Column="2" Content="结束计算" IsEnabled="False"
                                    Background="#41272B" BorderBrush="#76434A" Padding="7,7" FontSize="11"/>
                            <Button x:Name="ViewIntervalButton" Grid.Column="4" Content="查看结果" IsEnabled="False" Padding="7,7" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本地会话" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SessionCountText" Text="0 个日志" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                            </StackPanel>
                            <Button x:Name="OpenLogsButton" Grid.Column="1" Content="打开目录" Padding="9,5" FontSize="11"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="项目" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ProjectComboBox" Grid.Column="1" DisplayMemberPath="DisplayName" ToolTip="从 session_meta.cwd 自动识别本机 Codex 项目"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="统计范围" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ScopeComboBox" Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="整次任务" Tag="task"/>
                                <ComboBoxItem Content="最后一次调用" Tag="call"/>
                                <ComboBoxItem Content="所选项目累计" Tag="project"/>
                            </ComboBox>
                        </Grid>
                        <ListBox x:Name="SessionListBox" Grid.Row="3" DisplayMemberPath="DisplayName"/>
                        <TextBlock Grid.Row="4" Text="按日志最后更新时间排序；选择项目后可查看项目累计。" Foreground="#6F858F"
                                   FontSize="10" Margin="2,9,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="4,0,4,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedSessionText" Text="请选择一个会话" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UpdatedText" Text="等待日志数据" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#142C38" BorderBrush="#28516A" BorderThickness="1" CornerRadius="8"
                                Padding="10,5" VerticalAlignment="Center">
                            <TextBlock x:Name="ScopeBadgeText" Text="整次任务" Foreground="#7BC4FF" FontSize="11"/>
                        </Border>
                    </Grid>

                    <UniformGrid Columns="3" Rows="2">
                        <Border Style="{StaticResource CardStyle}" Margin="4" Height="118" Padding="15">
                            <StackPanel>
                                <TextBlock Text="使用模型" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="ModelMetricText" Text="—" Foreground="#F1FFFC" FontSize="21" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,11,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4" Height="118" Padding="15">
                            <StackPanel>
                                <TextBlock Text="缓存输入" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="CachedMetricText" Text="0" Foreground="{StaticResource AccentBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="tokens" Foreground="#66808A" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4" Height="118" Padding="15">
                            <StackPanel>
                                <TextBlock Text="未缓存输入" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="UncachedMetricText" Text="0" Foreground="#F3D37A" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="tokens" Foreground="#66808A" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4" Height="118" Padding="15">
                            <StackPanel>
                                <TextBlock Text="输出" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="OutputMetricText" Text="0" Foreground="{StaticResource BlueBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="tokens（含推理输出）" Foreground="#66808A" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4" Height="118" Padding="15">
                            <StackPanel>
                                <TextBlock Text="合计" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="TotalMetricText" Text="0" Foreground="#F4F7FA" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <TextBlock Text="输入 + 输出" Foreground="#66808A" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="4" Height="118" Padding="15">
                            <StackPanel>
                                <TextBlock Text="缓存命中率" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="HitRateMetricText" Text="0.0%" Foreground="#C9A7FF" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0"/>
                                <ProgressBar x:Name="HitRateProgress" Height="4" Minimum="0" Maximum="100" Value="0"
                                             Background="#29343D" Foreground="#A982E7" BorderThickness="0" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardStyle}" Margin="4,14,4,8" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="滚动 24 小时用量" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="磁盘汇总 · 仅保留最近 7 天" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,9"/>
                                <ComboBox x:Name="UsageHistoryRangeComboBox" Width="160" SelectedIndex="0" HorizontalAlignment="Left"
                                          ToolTip="每项都是连续24小时窗口，不是自然日">
                                    <ComboBoxItem Content="过去24小时" Tag="0"/>
                                    <ComboBoxItem Content="24–48小时前" Tag="1"/>
                                    <ComboBoxItem Content="2–3天前" Tag="2"/>
                                    <ComboBoxItem Content="3–4天前" Tag="3"/>
                                    <ComboBoxItem Content="4–5天前" Tag="4"/>
                                    <ComboBoxItem Content="5–6天前" Tag="5"/>
                                    <ComboBoxItem Content="6–7天前" Tag="6"/>
                                </ComboBox>
                                <TextBlock x:Name="UsageHistoryWindowText" Text="等待磁盘数据" Foreground="#78909A" FontSize="9" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#101B22" CornerRadius="10" Padding="14">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="总 Token" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="UsageHistoryTokenText" Text="0" Foreground="#F4F7FA" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="UsageHistoryModelText" Text="等待模型" Foreground="#66808A" FontSize="9" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#102C29" BorderBrush="#28554C" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="API 等价美元" Foreground="#A8C7C0" FontSize="10"/>
                                    <TextBlock x:Name="UsageHistoryUsdText" Text="$0.0000" Foreground="{StaticResource AccentBrush}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="UsageHistoryStatusText" Text="等待汇总" Foreground="#7FA39B" FontSize="9" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <DataGrid x:Name="UsageHistoryModelGrid" Grid.Row="2" Grid.ColumnSpan="5" AutoGenerateColumns="False" Height="158" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="*"/>
                                    <DataGridTextColumn Header="缓存输入" Binding="{Binding Cached}" Width="105"/>
                                    <DataGridTextColumn Header="未缓存输入" Binding="{Binding Uncached}" Width="105"/>
                                    <DataGridTextColumn Header="输出" Binding="{Binding Output}" Width="95"/>
                                    <DataGridTextColumn Header="总 Token" Binding="{Binding Total}" Width="105"/>
                                    <DataGridTextColumn Header="API 等价美元" Binding="{Binding Cost}" Width="115"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="4,6,4,8" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="图片与工具用量" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="与上方所选滚动24小时窗口一致 · 仅保存调用元数据" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="BackfillToolUsageButton" Grid.Column="1" Content="回填最近7天工具记录" Padding="10,6" FontSize="11"/>
                            </Grid>
                            <UniformGrid Columns="4" Margin="0,14,0,0">
                                <Border Background="#101B22" CornerRadius="9" Padding="12" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="工具调用" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                        <TextBlock x:Name="ToolCallCountText" Text="0" Foreground="#F4F7FA" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#101B22" CornerRadius="9" Padding="12" Margin="2,0">
                                    <StackPanel>
                                        <TextBlock Text="输入图片" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                        <TextBlock x:Name="InputImageCountText" Text="0" Foreground="#7BC4FF" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#101B22" CornerRadius="9" Padding="12" Margin="2,0">
                                    <StackPanel>
                                        <TextBlock Text="生成图片" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                        <TextBlock x:Name="GeneratedImageCountText" Text="0" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#101B22" CornerRadius="9" Padding="12" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="电脑截图" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                        <TextBlock x:Name="ComputerScreenshotCountText" Text="0" Foreground="#C9A7FF" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <DataGrid x:Name="ToolUsageGrid" AutoGenerateColumns="False" Height="150" AlternationCount="2" Margin="0,12,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="120"/>
                                    <DataGridTextColumn Header="工具" Binding="{Binding Tool}" Width="*"/>
                                    <DataGridTextColumn Header="次数" Binding="{Binding Calls}" Width="80"/>
                                    <DataGridTextColumn Header="完成" Binding="{Binding Completed}" Width="80"/>
                                    <DataGridTextColumn Header="失败" Binding="{Binding Failed}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ToolUsageStatusText" Text="等待本地工具元数据" Foreground="#78909A" FontSize="9" Margin="1,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="工具参数、命令、图片内容、URL和输出正文均不保存；本地日志缺少统一计费参数，因此次数不并入美元总额。"
                                       Foreground="#6F858F" FontSize="9" Margin="1,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="4,14,4,8" CornerRadius="15" BorderBrush="#28554C" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#16352F" Offset="0"/>
                                <GradientStop Color="#10252D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="20,17">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="官方 API 等价成本" Foreground="#A8C7C0" FontSize="12"/>
                                <TextBlock x:Name="UsdCostText" Text="$0.0000" Foreground="{StaticResource AccentBrush}" FontSize="36" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                <TextBlock x:Name="CostBreakdownText" Text="未缓存 $0 · 缓存 $0 · 输出 $0" Foreground="#8FA9A5" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="估算，不是账单" Foreground="#8FA9A5" FontSize="10" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="LongContextText" Text="标准上下文费率" Foreground="#D7E7E3" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="4,6,4,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Padding="17">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="5 小时额度" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="FiveHourResetText" Grid.Column="1" Text="暂无窗口" Foreground="#78909A" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="FiveHourUsageText" Text="暂无" Foreground="#F3D37A" FontSize="23" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="已用" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="FiveHourProgress" Height="5" Minimum="0" Maximum="100" Value="0"
                                                 Background="#29343D" Foreground="#E8B95E" BorderThickness="0" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="FiveHourDollarText" Text="美金额度：待日志数据" Foreground="#9FB0B7" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="17">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="周额度" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WeeklyResetText" Grid.Column="1" Text="暂无窗口" Foreground="#78909A" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="WeeklyUsageText" Text="暂无" Foreground="#C9A7FF" FontSize="23" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="已用" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="WeeklyProgress" Height="5" Minimum="0" Maximum="100" Value="0"
                                                 Background="#29343D" Foreground="#A982E7" BorderThickness="0" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="WeeklyDollarText" Text="美金额度：待日志数据" Foreground="#9FB0B7" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="QuotaEstimateHintText" Text="美元总额需通过一次使额度百分比上升的时间段测量进行反推。"
                                   Foreground="#6F858F" FontSize="9" Margin="3,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Style="{StaticResource CardStyle}" Margin="4,6,4,8" Padding="18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="当前模型官方 API 标准价" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PricingVerifiedText" Text="USD / 1M tokens" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="OpenPricingButton" Grid.Column="1" Content="查看官方价格" Padding="10,6" FontSize="11"/>
                            </Grid>
                            <UniformGrid Columns="3" Margin="0,14,0,0">
                                <Border Background="#101B22" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="未缓存输入" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        <TextBlock x:Name="InputPriceText" Text="—" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#101B22" CornerRadius="10" Padding="14" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="缓存输入" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        <TextBlock x:Name="CachedPriceText" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#101B22" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="输出" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                        <TextBlock x:Name="OutputPriceText" Text="—" Foreground="{StaticResource BlueBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock x:Name="FormulaText" Text="费用 = 未缓存输入 × 输入价 + 缓存输入 × 缓存价 + 输出 × 输出价"
                                       Foreground="#8399A2" FontSize="10" Margin="0,13,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="4,6,4,8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="内置官方价格表" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="标准处理价格；单位均为 USD / 1M tokens。价格可在 pricing.json 更新。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,10"/>
                            <DataGrid x:Name="PricingDataGrid" AutoGenerateColumns="False" Height="218" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="模型" Binding="{Binding Model}" Width="*"/>
                                    <DataGridTextColumn Header="输入" Binding="{Binding Input}" Width="90"/>
                                    <DataGridTextColumn Header="缓存输入" Binding="{Binding Cached}" Width="90"/>
                                    <DataGridTextColumn Header="输出" Binding="{Binding Output}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="CaveatText" Margin="7,4,7,14" Foreground="#70858E" FontSize="10" TextWrapping="Wrap"
                               Text="隐私：只读取 token_count、turn_context 和不含密钥的账号标签；不会读取或上传对话正文。"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#0E151C" BorderBrush="#22313B" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#81949C" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="LOCAL ONLY" Foreground="#4B766D" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
